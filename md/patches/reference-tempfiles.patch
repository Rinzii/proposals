+	set -e; ref_file=$$(mktemp "$@.XXXXXX"); trap 'rm -f "$$ref_file"' EXIT; $(PYTHON_BIN) $< < $(DATADIR)/srefs.json > "$$ref_file"; mv "$$ref_file" "$@"; trap - EXIT
 
